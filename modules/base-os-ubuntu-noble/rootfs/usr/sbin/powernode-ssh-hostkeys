#!/bin/bash
# Give a composed node a STABLE SSH host identity across reboot and recompose.
#
# THE PROBLEM. The root filesystem is an erofs+tmpfs overlay: the upper layer is
# ephemeral, so /etc/ssh/ssh_host_*_key is regenerated on EVERY boot by
# ssh-host-keygen.service. Every reboot therefore greets the operator with
# "REMOTE HOST IDENTIFICATION HAS CHANGED! ... Someone could be eavesdropping",
# and the only way forward is to scrub known_hosts. That is worse than an
# annoyance: it trains people to clear the one warning that actually matters, and
# it makes automation that connects over SSH unreliable by design. During the
# 2026-07-27 ops-hub work this fired on every single boot.
#
# THE FIX. Keep the host keys on the durable /persist partition and restore them
# into /etc/ssh BEFORE sshd reads them. /persist is mounted by the initramfs
# pivot before systemd starts, and this unit is ordered Before=local-fs.target
# (well ahead of sockets.target/ssh.socket), so the keys are in place by the time
# anything serves SSH.
#
# ON KEY MATERIAL. Keys are generated by the NODE, by ssh-keygen, exactly as
# ssh-host-keygen.service already does today — this changes only WHERE they live,
# not who creates them. Nothing here reads, prints, copies off-box or otherwise
# handles the private material: it is generated in place on /persist and copied
# into /etc/ssh with 0600. Generating directly in the persisted dir (rather than
# generating in /etc/ssh and copying out) means a private key is never written to
# the ephemeral layer first.
set -euo pipefail

# Roots are overridable ONLY so this can be exercised against a temp dir; both
# default to the real paths and nothing in production sets them. Without this
# the script is untestable except on a live node, which for a unit that gates
# SSH access is a bad place to find out it is wrong.
PERSIST_ROOT="${POWERNODE_PERSIST_ROOT:-/persist}"
ETC_SSH="${POWERNODE_ETC_SSH:-/etc/ssh}"

log() { echo "[ssh-hostkeys] $*"; }

# A node without /persist (a non-pivot host, a container) has nowhere durable to
# put these. Leave it to ssh-host-keygen.service and exit cleanly — this unit
# runs on every boot and must never fail one.
if ! mountpoint -q "$PERSIST_ROOT" 2>/dev/null; then
  log "$PERSIST_ROOT is not a mountpoint — leaving host keys ephemeral"
  exit 0
fi
if ! command -v ssh-keygen >/dev/null 2>&1; then
  log "ssh-keygen absent — nothing to persist"
  exit 0
fi

PDIR="$PERSIST_ROOT/etc/ssh"
install -d -m 0755 -o root -g root "$PERSIST_ROOT/etc"
install -d -m 0700 -o root -g root "$PDIR"

# Serialise against any other unit doing the same thing. A higher-priority
# module can ship its own host-key persister ordered into the same
# Before=local-fs.target window, in which case BOTH run and systemd is free to
# start them in parallel. Two ssh-keygen invocations racing on one path is how
# you get a truncated or half-written key — the failure would look like a
# corrupt host key at the worst possible moment. flock makes whichever runs
# second observe the first's finished work and reuse it.
#
# Deliberately stated generically: base-os is the shared floor under every node
# type and must not encode knowledge of any particular module above it. (The
# concrete case that motivated this — a dev-cell-local duplicate — was removed
# once this generalised version shipped.)
#
# -w 60: wait rather than skip. Bailing out would leave sshd with no persisted
# key and silently revert to an ephemeral identity, which is the bug this exists
# to fix; blocking briefly at early boot is the cheaper failure.
exec 9>"$PDIR/.hostkeys.lock"
if ! flock -w 60 9; then
  log "could not acquire host-key lock after 60s — another persister is stuck"
  exit 0
fi

# Generate any missing type directly in the persisted dir. Idempotent: the first
# boot creates, every later boot reuses — which is the entire point.
for t in rsa ecdsa ed25519; do
  f="$PDIR/ssh_host_${t}_key"
  if [ ! -s "$f" ]; then
    rm -f "$f" "$f.pub"
    ssh-keygen -q -t "$t" -f "$f" -N "" -C "powernode-node" </dev/null
    log "generated persisted ${t} host key"
  fi
done

# Restore into /etc/ssh so sshd serves the stable identity. -a preserves mode and
# timestamps; the explicit chmod below is belt-and-braces in case a key was ever
# created with a loose umask.
install -d -m 0755 "$ETC_SSH"
for f in "$PDIR"/ssh_host_*_key; do
  [ -e "$f" ] || continue
  cp -a "$f" "$f.pub" "$ETC_SSH"/ 2>/dev/null || true
done
chmod 600 "$PDIR"/ssh_host_*_key "$ETC_SSH"/ssh_host_*_key 2>/dev/null || true
chmod 644 "$PDIR"/ssh_host_*_key.pub "$ETC_SSH"/ssh_host_*_key.pub 2>/dev/null || true

log "restored persisted SSH host keys into $ETC_SSH"
