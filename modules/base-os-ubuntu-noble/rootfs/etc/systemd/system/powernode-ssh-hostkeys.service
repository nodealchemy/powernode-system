[Unit]
Description=Persist and restore SSH host keys for a stable identity across recompose
# Early boot: /persist is mounted by the initramfs pivot before systemd starts,
# so it is available here. The keys MUST land before anything serves SSH —
# Before=local-fs.target puts this well ahead of sockets.target (ssh.socket), and
# the explicit Before= on the ssh units is belt-and-braces.
#
# Ordering also defeats ssh-host-keygen.service without needing to modify it:
# that unit carries ConditionPathExistsGlob=!/etc/ssh/ssh_host_ed25519_key and
# runs After=local-fs.target, so once this one has restored the persisted keys
# its condition fails and it skips — no clobbering, no conflict, no duplicated
# generation logic.
DefaultDependencies=no
ConditionPathIsMountPoint=/persist
After=systemd-remount-fs.service
Before=local-fs.target ssh.service ssh.socket sshd.service systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/powernode-ssh-hostkeys
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=local-fs.target
