[Unit]
Description=Dev-cell: persist + restore SSH host keys for a stable SSH identity across recompose
Documentation=https://github.com/nodealchemy/powernode-platform
# Early boot, same window as dev-cell-persist-home.service (/persist is mounted
# by the initramfs pivot before systemd starts). MUST land the host keys before
# sshd reads them — local-fs.target precedes sockets.target (ssh.socket), and the
# explicit Before= on ssh.service/ssh.socket is belt-and-suspenders.
DefaultDependencies=no
ConditionPathIsMountPoint=/persist
After=systemd-remount-fs.service dev-cell-persist-home.service
Before=local-fs.target ssh.service ssh.socket sshd.service systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/dev-cell-ssh-hostkeys.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=local-fs.target
