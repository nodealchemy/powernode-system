[Unit]
Description=Dev-cell: ensure operator development DB (powernode role + powernode_development)
Documentation=https://github.com/nodealchemy/powernode-platform
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/local/bin/dev-cell-dev-db.sh
# psql/createuser/createdb come from postgres-primary (co-assigned); skip
# cleanly on a template without it rather than crash-loop.
ConditionPathExists=/usr/bin/psql
# Bounds the [Service] Restart=on-failure below to 10 attempts per 30 minutes.
# These two keys are [Unit]-section keys — systemd parses start rate limiting on
# the unit, not the service. Declared under [Service] they are silently dropped
# ("Unknown key name 'StartLimitIntervalSec' in section 'Service', ignoring")
# and the unit crash-loops unbounded, which is what it did until 2026-07-27.
StartLimitIntervalSec=1800
StartLimitBurst=10

[Service]
Type=oneshot
RemainAfterExit=yes
# Waits for Postgres internally (pg_isready poll); disable the default 90s
# ExecStart timeout so the poll can run its full bounded window on a cold boot.
TimeoutStartSec=0
ExecStart=/usr/local/bin/dev-cell-dev-db.sh
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
