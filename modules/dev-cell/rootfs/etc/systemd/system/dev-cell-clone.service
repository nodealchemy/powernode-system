[Unit]
Description=Dev-cell: auto-clone operator source workspace once the git key is authorized (as pnadmin)
Documentation=https://github.com/nodealchemy/powernode-platform
After=network-online.target home-pnadmin.mount dev-cell-git-keygen.service dev-cell-dev-db.service
Wants=network-online.target
Requires=dev-cell-git-keygen.service
ConditionPathExists=/usr/local/bin/dev-cell-clone.sh
ConditionPathIsMountPoint=/persist
# Skip once the workspace is cloned (idempotent belt beside the script's own
# git-dir check), so a reboot doesn't re-run bundle/npm needlessly. The platform
# repo is cloned to the root of ~/work (REPOS "powernode-platform:." in
# dev-cell-clone.sh), so its git dir is ~/work/.git — NOT ~/work/powernode-platform/.git.
ConditionPathExists=!/persist/home/pnadmin/work/.git
# Bounds the [Service] Restart=on-failure below to 5 attempts per hour. These
# two keys are [Unit]-section keys — systemd parses start rate limiting on the
# unit, not the service. Declared under [Service] they are silently dropped
# ("Unknown key name 'StartLimitIntervalSec' in section 'Service', ignoring")
# and the unit crash-loops unbounded, which is what it did until 2026-07-27.
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
# Runs AS THE OPERATOR (pnadmin). WAIT mode: polls for the delivery-time key
# registration for ~20 min, then clones + bundle + npm — so the operator
# reconnects to an already-cloned box with no manual step. Cloning + bundling +
# npm ci legitimately take many minutes; disable the 90s ExecStart timeout.
TimeoutStartSec=0
Environment=DEV_CELL_CLONE_WAIT=1
ExecStart=/usr/sbin/runuser -u pnadmin -- /usr/local/bin/dev-cell-clone.sh
StandardOutput=journal
StandardError=journal
# If the key never gets registered (poll window elapses) the unit fails; the
# operator can run `dev-cell-clone` by hand later. Bounded retries so it isn't
# a permanent crash-loop.
Restart=on-failure
RestartSec=60s

[Install]
WantedBy=multi-user.target
