[Unit]
Description=Dev-cell: autonomous campaign dev-loop ROOT supervisor (sandboxes agent work as pnagent)
Documentation=https://github.com/nodealchemy/powernode-platform
After=dev-cell-provision.service dev-cell-mcp-proxy.service network-online.target
Requires=dev-cell-provision.service dev-cell-mcp-proxy.service
ConditionPathExists=/var/lib/dev-cell/provisioned
# The headless `claude` CLI this unit drives (via `runuser -u pnagent`),
# and the credential-fetch script it reuses for its own ANTHROPIC_API_KEY,
# both come from the claude-tmux module — fail closed (skip) rather than
# crash-loop if it isn't co-assigned on this instance's template.
ConditionPathExists=/usr/bin/claude
ConditionPathExists=/usr/local/bin/claude-tmux-fetch-credential.sh

[Service]
Type=simple
# PRIVILEGE SEPARATION: runs as root, NOT pnagent — this unit is the
# TRUSTED SUPERVISOR. It holds the Gitea deploy key (for the actual `git
# push`) and drives all agent-authored work (headless `claude`,
# scripts/validate.sh) sandboxed via `runuser -u pnagent`, never directly.
# See dev-cell-executor.sh's own header comment and this module's
# manifest.yaml description for the full rationale. No User=/Group=/
# HOME= override here — systemd's own root default is exactly right.
Environment=DEV_LOOP_NAME=dev-improve
Environment=POLL_INTERVAL_ACTIVE=15
Environment=POLL_INTERVAL_IDLE=300
Environment=MAX_CONSECUTIVE_FAILURES=5
Environment=DEV_CELL_MCP_PROXY_BIND=127.0.0.1
Environment=DEV_CELL_MCP_PROXY_PORT=18443
# Deliberately NOT declaring this unit's own RuntimeDirectory=: the
# ExecStartPre below reuses claude-tmux-fetch-credential.sh as-is, and
# pointing it at dev-cell-bootstrap.service's already-root-owned
# /run/dev-cell (via this override of the env var that script already
# reads) keeps every dev-cell secret — the Gitea SSH deploy key, the
# node's own mTLS client cert/key, and the Anthropic API key — in the ONE
# tmpfs runtime directory, all with the same lifetime (this boot only)
# AND the same root-only confinement.
Environment=RUNTIME_DIRECTORY=/run/dev-cell

# Runs as root (the "+" prefix) — only root can read the on-node agent's
# mTLS private key. CLAUDE_TMUX_USER=root (overriding that script's own
# pnadmin default) keeps /run/dev-cell/api_key root-owned too — this
# unit's own process (root) reads-then-deletes it exactly once at start
# (see dev-cell-executor.sh), then hands ANTHROPIC_API_KEY down to
# pnagent's `claude` invocations via `runuser --preserve-environment`,
# never a pnagent-readable file. Never a systemd/tmux argv either,
# mirroring claude-tmux-start.sh's own handling of the same secret.
Environment=CLAUDE_TMUX_USER=root
ExecStartPre=+/usr/local/bin/claude-tmux-fetch-credential.sh

ExecStart=/usr/local/bin/dev-cell-executor.sh
Restart=on-failure
RestartSec=30s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
