#!/bin/bash
# powernode-rails-exec — wrapper for an OUT-OF-BAND `bundle exec` against
# this node's rails app (an operator's manual `console`/`runner`/etc.).
#
# WHY THIS EXISTS (IMP-01a0e40a-c0ef). extensions_loader_helper.rb's
# discover_extension_gems_by_visibility only includes an extension as a
# Gemfile PATH gem when POWERNODE_DEPLOYED=1 is set AND the extension is
# actually present on disk. Without that env var, discovery falls back to
# .gitmodules-gated public visibility — but .gitmodules is never shipped
# to a deployed node, so that mode finds ZERO extension path gems and
# Bundler.setup rewrites Gemfile.lock down to none the moment any bundler
# command runs. A bare `bundle exec rails console` run by hand therefore
# corrupts the lockfile away from what the `rails` service itself needs.
# Running everything through this wrapper instead means an out-of-band
# invocation resolves the SAME extensions the service does.
#
# WHAT ENV THIS ACTUALLY SETS (review round correction — an earlier
# revision of this file claimed "the EXACT SAME env" rails-setup.sh's
# re-lock section and rails-start.sh both resolve through; that was never
# true of the re-lock section, which resolves in an ISOLATED scratch env
# on purpose (see that section's own header for why), and it undersold
# what a real `rails console`/`runner` actually needs). The `rails`
# service's env comes from two places:
#   1. modules/powernode-hub-backend/manifest.yaml's static `env:` block
#      (RAILS_ENV, DATABASE_URL, REDIS_URL, POWERNODE_DEPLOYED,
#      CACHE_STORE, QUEUE_ADAPTER, POWERNODE_CA_MODE, ...). This wrapper
#      cannot read the manifest at runtime — there is no on-node copy of
#      it to parse — so those values are HARDCODED below, kept in sync BY
#      HAND with that file. A manifest change to the rails `env:` block
#      must be mirrored here too.
#   2. $STATE_DIR/backend-default.conf, which rails-start.sh writes on
#      first boot and sources (`set -a`) for everything else
#      (SECRET_KEY_BASE, the AR encryption keys, JWT_*,
#      CREDENTIAL_ENCRYPTION_KEY_DEFAULT, POWERNODE_CA_LOCAL_DIR). This
#      wrapper sources that same file the same way — but see the SECURITY
#      note below for WHEN.
#
# RUNS AS $RAILS_USER, never as root (review round, MEDIUM): a bare
# `bundle exec` run directly as root would leave root-owned tmp/log
# files under a tree rails itself needs to write, and would resolve
# gemspecs as root the same way rails-setup.sh's OWN re-lock section used
# to before its isolation fix — this wrapper avoids that class entirely
# by dropping to $RAILS_USER via `runuser` BEFORE ever invoking bundle,
# rather than trying to sandbox a root bundle invocation the way
# rails-setup.sh's re-lock section must. A caller that is already
# $RAILS_USER skips the drop (nothing to drop).
#
# SECURITY (second review round, MEDIUM — same escalation class as
# rails-setup.sh's HIGH finding): an earlier revision of this script
# sourced $SECRETS_FILE (`set -a; . "$SECRETS_FILE"; set +a`) BEFORE
# dropping privileges, i.e. AS ROOT. $SECRETS_FILE is rails-owned,
# rails-writable state — `.` sourcing executes its contents as ARBITRARY
# SHELL, not just variable assignment, so a compromised/buggy rails
# process could inject a command there and have root run it the very
# next time an operator used this wrapper (or, more subtly, override
# $needs_runuser/$PATH/etc. before the drop even happens). Fixed by
# deciding identity and validating everything FIRST, using only
# hardcoded/manifest values as root, and sourcing $SECRETS_FILE only
# INSIDE the command handed to `runuser` — root itself never reads its
# contents as executable shell. A caller that is already $RAILS_USER
# sources it directly (no escalation risk there: same trust level).
#
# Usage: powernode-rails-exec <bundle-exec-args...>
#   e.g. powernode-rails-exec rails console
#        powernode-rails-exec rails runner some_script.rb
#        powernode-rails-exec rails db:migrate:status
set -euo pipefail

RAILS_DIR=/opt/powernode/server
RAILS_USER=powernode-rails

if mountpoint -q /persist 2>/dev/null; then
  STATE_DIR=/persist/powernode-rails
else
  STATE_DIR=/var/lib/powernode-rails
fi
SECRETS_FILE="$STATE_DIR/backend-default.conf"

# Identity decision FIRST, before anything privileged or rails-influenced
# runs (see the SECURITY note above).
caller_user="$(id -un)"
needs_runuser=1
if [ "$caller_user" = "$RAILS_USER" ]; then
  needs_runuser=0
elif [ "$caller_user" != "root" ]; then
  echo "powernode-rails-exec: must run as root (which drops to $RAILS_USER) or as $RAILS_USER itself -- refusing to run as $caller_user" >&2
  exit 1
fi

# Refuse rather than silently run as the wrong identity (review round):
# this wrapper's whole point is matching the SERVICE's identity, and
# there is no safe way to drop root -> $RAILS_USER without `runuser`.
if [ "$needs_runuser" = "1" ] && ! command -v runuser >/dev/null 2>&1; then
  echo "powernode-rails-exec: runuser is not available on this host, and the caller ($caller_user) is not $RAILS_USER -- refusing to run any other way" >&2
  exit 1
fi

if [ ! -f "$SECRETS_FILE" ]; then
  echo "powernode-rails-exec: $SECRETS_FILE does not exist yet -- rails has never completed its first boot on this node" >&2
  exit 1
fi

# Manifest env (systemd Environment=, not the generated secrets file --
# see this script's header for why). Kept in sync BY HAND with
# modules/powernode-hub-backend/manifest.yaml's rails `env:` block.
# Literal hardcoded values only -- safe to set as root, unlike anything
# read from $SECRETS_FILE.
export RAILS_ENV=production
export RAILS_LOG_TO_STDOUT=1
export DATABASE_URL="postgres://powernode@localhost:5432/powernode_production"
export REDIS_URL="redis://localhost:6379/0"
export POWERNODE_DEPLOYED=1
export CACHE_STORE=memory_store
export QUEUE_ADAPTER=async
export POWERNODE_CA_MODE=local

# Same vendored-gem resolution and cache location rails-start.sh uses at
# runtime.
export BUNDLE_GEMFILE="$RAILS_DIR/Gemfile"
export BUNDLE_PATH="$STATE_DIR/vendor/bundle"
export BUNDLE_APP_CONFIG="$STATE_DIR/.bundle"
export HOME="$STATE_DIR"
export BOOTSNAP_CACHE_DIR="$STATE_DIR/bootsnap"

# Sanitize inherited caller env that could otherwise leak into (or
# silently override) the resolution above (review round) -- unset BEFORE
# any drop, via `runuser -p`, so the dropped child never sees them
# either. RUBYOPT/GEM_* can redirect which ruby/gems actually load;
# leftover BUNDLE_* from the caller's own shell (a different app, a
# different bundle invocation) could otherwise win over -- or conflict
# with -- the exports just above.
unset RUBYOPT GEM_HOME GEM_PATH GEM_ROOT 2>/dev/null || true
unset BUNDLE_WITHOUT BUNDLE_FROZEN BUNDLE_DEPLOYMENT BUNDLE_BIN 2>/dev/null || true

cd "$RAILS_DIR"

if [ "$needs_runuser" = "1" ]; then
  # `-p`/`--preserve-environment`: without it, runuser resets the
  # environment the same way `su` (without `-`) partially does, which
  # would drop every export above right before the command that needs
  # them. $SECRETS_FILE is sourced HERE, inside the command runuser
  # actually executes as $RAILS_USER -- never by this (root) process
  # itself; see the SECURITY note above. `_` is the placeholder $0 for
  # the inline script; "$1" is $SECRETS_FILE, and "$@" after the `shift`
  # is this wrapper's own original arguments.
  exec runuser -u "$RAILS_USER" -p -- bash -c '
    set -a
    # shellcheck disable=SC1090
    . "$1"
    set +a
    shift
    exec /usr/local/bin/bundle exec "$@"
  ' _ "$SECRETS_FILE" "$@"
else
  # Already $RAILS_USER -- no privilege boundary crossed, so sourcing
  # $SECRETS_FILE directly in this process carries no escalation risk
  # (same trust level as the file's own owner).
  set -a
  # shellcheck disable=SC1090
  . "$SECRETS_FILE"
  set +a
  exec /usr/local/bin/bundle exec "$@"
fi
