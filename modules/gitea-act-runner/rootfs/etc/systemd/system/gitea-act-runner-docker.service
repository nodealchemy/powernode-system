# Renamed from apt's docker.service/docker.socket (same [Service] body,
# --bridge=none folded straight into ExecStart — see this module's
# manifest.yaml description and rootfs/etc/gitea-act-runner/config.yaml).
#
# The rename itself is load-bearing, not cosmetic: the platform's
# Container Runtimes (Phase 1 Docker) feature runs an on-node reconciler
# (agent/internal/dockerd/manager.go) that watches the literal unit name
# "docker.service" and stops it unconditionally whenever the account-wide
# `docker-engine` NodeModule isn't assigned to the node — with no way to
# tell "docker-engine-managed daemon" apart from any other module's own
# local Docker install using the same well-known unit name. This module
# deliberately does NOT use the docker-engine module (see manifest.yaml
# description: local unix-socket-only, no SDWAN, no managed DockerHost),
# so under the apt-shipped name the reconciler killed this daemon ~5s
# after every start. Enabling it under a name the reconciler never looks
# for sidesteps the conflict entirely — no Go agent changes needed.
[Unit]
Description=gitea-act-runner Docker Application Container Engine
Documentation=https://docs.docker.com
After=network-online.target containerd.service
Wants=network-online.target containerd.service
Requires=gitea-act-runner-docker.socket

[Service]
Type=notify
ExecStart=/usr/bin/dockerd -H fd:// --containerd=/run/containerd/containerd.sock --bridge=none
ExecReload=/bin/kill -s HUP $MAINPID
TimeoutSec=0
RestartSec=2
Restart=always
StartLimitBurst=3
StartLimitInterval=60s
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
KillMode=process
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
