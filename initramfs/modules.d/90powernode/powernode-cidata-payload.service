[Unit]
Description=Powernode NoCloud cicustom stager (pre-pivot: federation payload + enrollment identity)
Documentation=https://github.com/nodealchemy/powernode-platform
# Same gate as powernode-federation-accept.service — skip on recovery boots
# (powernode.boot=0) where enrollment is intentionally suppressed.
ConditionKernelCommandLine=powernode.boot=1
DefaultDependencies=no
# Run after block devices are coldplugged (basic.target) and BEFORE both
# federation-accept (the file fallback at /etc/powernode/federation-payload.json
# must be in place when it looks for it) AND powernode-agent (the staged
# /run/powernode/identity.cfg — Option 3 enrollment identity — must be in place
# before the agent's identity resolver runs; see agent/internal/identity/
# identity.go DefaultResolver). Listed explicitly rather than relying on the
# transitive Before=federation-accept->agent chain, so this ordering holds
# even if federation-accept's own dependencies ever change. No network
# dependency: this only touches a local CD-ROM. federation-accept and the
# agent additionally wait on network-online, so this comfortably completes
# first.
After=basic.target
Before=powernode-federation-accept.service powernode-agent.service
Wants=basic.target

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/sbin/powernode-cidata-payload
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
