[Unit]
Description=Powernode: grow the persist partition to its bounded size
Documentation=https://github.com/nodealchemy/powernode-platform
DefaultDependencies=no
# Nothing to grow if there's no persist-labeled partition (tmpfs fallback path).
ConditionPathExists=/dev/disk/by-label/persist
Before=persist.mount

[Service]
Type=oneshot
RemainAfterExit=yes
# Grow the baked-small "persist" partition to its bounded target (default 12G,
# env POWERNODE_PERSIST_SIZE_GB) on first boot; idempotent no-op thereafter.
# Only resizes the partition + filesystem — persist.mount does the mount. This
# runs pre-mount, so resize2fs operates offline. Best-effort: a failure still
# lets persist.mount try the existing (unresized) partition.
ExecStart=/sbin/powernode-agent persist-prepare
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=local-fs.target
