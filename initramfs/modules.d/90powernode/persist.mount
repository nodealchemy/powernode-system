[Unit]
Description=Powernode persistent state (/persist, disk-backed)
Documentation=https://github.com/nodealchemy/powernode-platform
DefaultDependencies=no
# Only mount the disk if its labeled partition is present; otherwise
# persist-fallback.service provides a tmpfs /persist (physical/edge devices
# whose image predates this layout). systemd derives this unit's name from the
# mount point (/persist), so the tmpfs fallback CANNOT be a second .mount unit —
# it's a service that runs `mount` instead.
ConditionPathIsMountPoint=!/persist
ConditionPathExists=/dev/disk/by-label/persist
# Grow the (baked-small) partition to its bounded size before mounting.
Wants=persist-grow.service
After=persist-grow.service
Before=powernode-agent.service powernode-mount.service local-fs.target

[Mount]
# The boot disk image bakes an ext4 partition labeled "persist" for PKI + the
# OCI module cache to survive reboots (claim-by-id is single-bind — a wiped
# enrolled cert can't re-claim). Mount it by stable LABEL: VM disk names vary
# (/dev/sda scsi vs /dev/vda virtio), and the initramfs has no other handle
# (NodeInstance.config["storage_volume"] is only fetched post-pivot over HTTP).
# Replaces the prior tmpfs, which silently discarded PKI + cache every power
# cycle.
What=/dev/disk/by-label/persist
Where=/persist
Type=ext4
Options=rw,noatime,nofail

[Install]
WantedBy=local-fs.target
