[Unit]
Description=Powernode persistent state (/persist, tmpfs fallback)
Documentation=https://github.com/nodealchemy/powernode-platform
DefaultDependencies=no
ConditionPathIsMountPoint=!/persist
# Only when there is NO disk-backed persist partition — this is the mutually
# exclusive counterpart to persist.mount's ConditionPathExists=/dev/disk/by-label/persist.
ConditionPathExists=!/dev/disk/by-label/persist
Before=powernode-agent.service powernode-mount.service local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Physical/edge devices whose image predates the persist partition layout: fall
# back to a tmpfs /persist so boot still works. NOT reboot-surviving — the
# disk-backed persist.mount is always preferred when the partition exists.
ExecStart=/bin/sh -c 'exec mount -t tmpfs -o mode=0755,size=4G tmpfs /persist'

[Install]
WantedBy=local-fs.target
