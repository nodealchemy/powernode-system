[Unit]
Description=Powernode: prepare overlay union + switch-root into module rootfs
Documentation=https://github.com/nodealchemy/powernode-platform
ConditionKernelCommandLine=powernode.boot=1
ConditionPathExists=/sbin/powernode-agent
DefaultDependencies=no

# Run AFTER the agent has had time to enroll and persist the mTLS cert. The
# ExecStartPre wait-for-cert below is the actual gate; the After= just keeps
# systemd's ordering reasonable.
#
# systemd-modules-load.service listed explicitly for the same reason as
# powernode-agent.service (see its own comment) — After=basic.target alone
# does not guarantee that specific unit has finished, and this unit's own
# ComposeForPivot -> MountUnion call races the same overlay-module-load gap.
After=basic.target powernode-agent.service powernode-ssh-keygen.service systemd-modules-load.service
Wants=basic.target powernode-agent.service systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes

# Load the nftables subsystem into the running kernel BEFORE switch_root, so the
# post-pivot reconciler's `nft` egress apply finds nf_tables already registered
# (switch_root re-uses the same kernel; the pivot rootfs ships no /lib/modules).
# Guaranteed belt alongside the modules-load.d drop-in — leading `-` keeps a
# modprobe failure non-fatal so a missing module never blocks the pivot (BUG-J).
ExecStartPre=-/bin/sh -c 'modprobe -a nf_tables nft_ct nf_conntrack'

# Same belt for overlay + erofs, guarding THIS unit's own ComposeForPivot ->
# MountUnion call below — see powernode-overlay.conf for the incident this
# guards against (union mount intermittently failing with "special device
# overlay does not exist" because the kernel's on-demand module autoload
# raced the mount(2) call).
ExecStartPre=-/bin/sh -c 'modprobe -a overlay erofs'

# Same belt for bridge + br_netfilter + llc + stp — see powernode-bridge.conf
# for the incident this guards against (dockerd's default bridge network
# creation failing with "operation not supported" post-pivot).
ExecStartPre=-/bin/sh -c 'modprobe -a bridge br_netfilter llc stp'

# Same belt for nf_nat + nft_masq + xt_MASQUERADE + nft_chain_nat +
# nft_compat + xt_conntrack + xt_addrtype + xt_tcpudp + xt_multiport — see
# powernode-nat.conf for the incident this guards against (dockerd's
# NAT/MASQUERADE POSTROUTING rule failing with "missing kernel module?" /
# "CHAIN_ADD failed" / "RULE_INSERT failed" post-pivot).
ExecStartPre=-/bin/sh -c 'modprobe -a nf_nat nft_masq xt_MASQUERADE nft_chain_nat nft_compat xt_conntrack xt_addrtype xt_tcpudp xt_multiport'

# Same belt for veth — see powernode-veth.conf for the incident this guards
# against (container endpoint creation failing with "operation not
# supported" post-pivot, one layer deeper than bridge/NAT).
ExecStartPre=-/bin/sh -c 'modprobe -a veth'

# Wait until the agent has enrolled. Caps at ~120s — if enrollment never
# completes, we give up rather than hanging the boot. The unit's `Restart=`
# isn't applicable to oneshot; if this fails the smoke run continues with
# the initramfs sshd as fallback.
ExecStartPre=/bin/sh -c 'i=0; while [ ! -f /persist/var/lib/powernode/pki/node.crt ] && [ "$i" -lt 120 ]; do sleep 1; i=$((i+1)); done; test -f /persist/var/lib/powernode/pki/node.crt'

# Compose the overlay union at /sysroot from the platform's REAL assigned
# module set, pulled dynamically over OCI (erofs blobs + cosign/fs-verity
# verify + overlay union + identity/native units) — the same ComposeForPivot
# the boot orchestrator uses. Enrollment already happened (federation-accept +
# the cert the ExecStartPre above gates on); --source oci reuses that enrolled
# PKI to pull + compose. Replaces the legacy hardcoded 9p `--modules
# system-base,nginx` path, which needed a libvirt 9p share absent on real
# hypervisors and only ever composed a 2-module stub.
ExecStart=/sbin/powernode-agent prepare-root --source oci

# Re-exec systemd into the new root. --no-block because the very act of
# switch-root kills this unit's executor — waiting would deadlock.
ExecStartPost=/usr/bin/systemctl --no-block switch-root /sysroot /sbin/init

StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
